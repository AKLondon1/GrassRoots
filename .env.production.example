# Production build and deploy. An EXAMPLE: copy it, do not ship it.
#
# WHY THIS FILE EXISTS. `npm run build` could not succeed from a clean checkout. The
# guard in lib/env.ts refuses a production build without an explicit data mode and a
# canonical HTTPS origin, and .env.example -- the only committed example -- carries
# `http://localhost:3000`, which that guard correctly rejects. So the command printed
# in every handoff document was unrunnable, and nobody noticed until Task 13 ran it.
#
# The guard is right and stays. This file is the missing half: the shape of an
# environment a production build actually accepts.
#
# Verified by tests/unit/env-examples.test.ts, which parses this file through the same
# schema lib/env.ts uses. If the guard changes, this example fails rather than rots.

# Must be explicit in production. `supabase` for a real deployment; `demo` only for a
# published preview with no database behind it.
NEXT_PUBLIC_DATA_MODE=supabase

# The canonical HTTPS origin, and nothing else: no port, path, query, hash, trailing
# slash, credentials or wildcard. A preview URL will not do -- it must be the origin
# the application is actually served from, because it is also the origin the sign-in
# callback is validated against.
APP_ORIGIN=https://grassroots.example.org

# From the Supabase project's API settings. The URL and the anon key are public by
# design and reach the browser; the service-role key never does and must never be
# given a NEXT_PUBLIC_ name.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# At least 32 characters, random, used only by the scheduled internal job endpoint.
CRON_SECRET=
