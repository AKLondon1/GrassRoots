# Local development starts in explicit demo mode without external services.
# The public beta MUST instead use NEXT_PUBLIC_DATA_MODE=supabase.
NEXT_PUBLIC_DATA_MODE=demo
# Local development origin. Deliberately NOT production-valid: it is http and it
# carries a port, and lib/env.ts:62-67 refuses both when NODE_ENV=production. That is
# the guard working, not a bug -- `next build` sets NODE_ENV=production, so building
# with this file fails with "Production requires APP_ORIGIN to be the canonical HTTPS
# origin". Copy .env.production.example for that; see README "Building for
# production".
#
# Do not use a wildcard, preview URL, credentials, path, query, hash or trailing
# slash in the production value.
APP_ORIGIN=http://localhost:3000

# Set all three values to use Supabase in a deployed environment. Keep the
# service-role value server-only; it must never use a NEXT_PUBLIC_ name.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Long random bearer token used only by the scheduled internal job endpoint.
CRON_SECRET=

# Optional provider credentials. Features stay visibly in development mode when unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Keep false until your club has completed its privacy review. Server-side only.
OPENAI_COACHING_ENABLED=false

# Shareable beta: Google OAuth is configured in Supabase Auth. Leave both
# values unset until a custom sending domain is verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=

# HTTPS adapter receiving { recipientMembershipId, title, body, idempotencyKey }.
PUSH_PROVIDER_URL=
PUSH_PROVIDER_TOKEN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# At least 32 random characters. Rotation requires re-registering subscriptions.
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=

# HTTPS malware scanner accepting raw file bytes and returning { clean, engine }.
SCANNER_API_URL=
SCANNER_API_TOKEN=
