# Use demo mode without external services.
NEXT_PUBLIC_DATA_MODE=demo

# Set all three values to use Supabase in a deployed environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional provider credentials. Features stay visibly in development mode when unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
