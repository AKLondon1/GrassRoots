# Use demo mode without external services.
NEXT_PUBLIC_DATA_MODE=demo
# Local development origin. Production must use the canonical HTTPS origin.
APP_ORIGIN=http://localhost:3000

# Set all three values to use Supabase in a deployed environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Long random bearer token used only by the scheduled internal job endpoint.
CRON_SECRET=

# Optional provider credentials. Features stay visibly in development mode when unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Keep false until your club has completed its privacy review. Server-side only.
OPENAI_COACHING_ENABLED=false

# Transactional email is delivered through Resend.
RESEND_API_KEY=
EMAIL_FROM=GrassRoots <notifications@example.org>

# HTTPS adapter receiving { recipientMembershipId, title, body, idempotencyKey }.
PUSH_PROVIDER_URL=
PUSH_PROVIDER_TOKEN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# At least 32 random characters. Rotation requires re-registering subscriptions.
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=

# HTTPS malware scanner accepting raw file bytes and returning { clean, engine }.
SCANNER_API_URL=
SCANNER_API_TOKEN=
